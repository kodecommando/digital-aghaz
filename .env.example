# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# ADMIN_EMAIL: Authorized administrator email for magic-link authentication and lead notifications.
ADMIN_EMAIL="salmancreatorlabs@gmail.com"

# ADMIN_PASSCODE: Optional server-side administrator passcode for /admin login (never expose to client).
ADMIN_PASSCODE=""

# SESSION_SECRET: Cryptographic secret for signing HTTP-only admin session cookies.
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_HEX_SECRET"

# SMTP_* : Optional Gmail / SMTP settings for live email forwarding to ADMIN_EMAIL (e.g. Gmail App Password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="salmancreatorlabs@gmail.com"
SMTP_PASS=""

# RESEND_API_KEY: Optional transactional email key (Resend) for inquiry & magic-link delivery.
RESEND_API_KEY=""

# EMAIL_FROM: Verified sender email address when email delivery is configured.
EMAIL_FROM="Digital Aghaz <salmancreatorlabs@gmail.com>"

# ALLOWED_ORIGIN: Comma-separated allowed CORS origin(s) for production.
ALLOWED_ORIGIN="http://localhost:3000"

# ENABLE_DEV_MAGIC_LINK: Set to "true" ONLY in local development to inspect magic links safely without an email provider.
ENABLE_DEV_MAGIC_LINK="false"
